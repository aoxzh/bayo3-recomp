<Project Sdk="Microsoft.NET.Sdk">
  <!-- SMW harness adapted for B3; Ryujinx shader source is supplied locally, not blade2 runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Ryujinx.Graphics.Shader</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;StaticGpuAccessor.cs;Disassemble.cs" />
    <Compile Include="$(RyuShader)/**/*.cs" Exclude="$(RyuShader)/obj/**;$(RyuShader)/bin/**" />
    <Reference Include="Ryujinx.Common"><HintPath>$(RyuLib)/Ryujinx.Common.dll</HintPath></Reference>
    <Reference Include="Spv.Generator"><HintPath>$(RyuLib)/Spv.Generator.dll</HintPath></Reference>
    <EmbeddedResource Include="$(RyuShader)/CodeGen/Glsl/HelperFunctions/*.glsl" LogicalName="Ryujinx.Graphics.Shader.CodeGen.Glsl.HelperFunctions.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

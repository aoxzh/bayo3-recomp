+        // Maxwell MOV writes only the quad lanes its 4-bit mask selects (bit0 = lane 0 .. bit3 = lane 3);
+        // 0xF is the ordinary all-lanes case. A masked write leaves the unselected lanes untouched, so the
+        // value has to be read back and selected per lane. See docs/BAYONETTA3_SHADERS.md.
+        private static void EmitMovQuadMasked(EmitterContext context, int dest, Operand src, int quadMask)
+        {
+            if (quadMask == 0xF)
+            {
+                context.Copy(GetDest(dest), src);
+                return;
+            }
+
+            Operand laneInQuad = context.BitwiseAnd(LoadLaneId(context), Const(3));
+            Operand selected = context.ICompareEqual(laneInQuad, Const(QuadMaskToLane(quadMask)));
+
+            context.Copy(GetDest(dest), context.ConditionalSelect(selected, src, GetSrcReg(context, dest)));
+        }
+
+        // The mask has one bit per quad lane, so the selected lane is the index of its single set bit.
+        private static int QuadMaskToLane(int quadMask)
+        {
+            return quadMask switch { 1 => 0, 2 => 1, 4 => 2, 8 => 3, _ => -1 };
+        }
+
+        private static Operand LoadLaneId(EmitterContext context)
+        {
+            if (context.TranslatorContext.GpuAccessor.QueryHostSubgroupSize() <= 32)
+            {
+                return context.Load(StorageKind.Input, IoVariable.SubgroupLaneId);
+            }
+
+            return context.BitwiseAnd(context.Load(StorageKind.Input, IoVariable.SubgroupLaneId), Const(0x1f));
+        }

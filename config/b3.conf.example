# Bayonetta 3 recomp — player settings.
#
# Copy to private/b3.conf (scripts/b3_play.sh does this on first launch), edit, or use the launcher
# (scripts/b3_launcher.sh), which edits this same file. Every key=value line becomes the environment
# variable NX_<KEY> before the runtime starts; names use lower-case runtime switch names.
# A value of false, off, no or empty leaves a switch unset.
# A value of 0 also leaves it unset, except for pad_deadzone, pad_trigger, pad_index, fsr_sharp and
# mouse_camera, where 0 is a value. The "off" entries below document their switches with 0.

# ---- Picture ---------------------------------------------------------------------------------
# The window size. The game itself renders at its console size, 1600x900 docked (handheld=0) or
# 1280x720 handheld (handheld=1), and the picture is scaled to the window (fsr=1 sharpens that).
# A larger window is not a higher internal resolution. `auto` uses the largest 16:9 area that fits
# the display, the right choice on a tablet or phone in desktop mode.
resolution=1600x900
fullscreen=0             # 1: fullscreen (F11 or Alt+Enter toggles at any time)
fsr=0                    # 1: FidelityFX Super Resolution 1 when the window is larger than the render
fsr_sharp=               # FSR sharpening: 0, 1, 2; empty = 0.2
fps_cap=                 # empty = runtime/game pacing; 30 = 30 fps mode; Android defaults to 30.
display_hz=              # the rate the game paces itself by: 60, 90, 120, 144; empty = the display's own.
                         # Above 60 the runtime converts the gameplay step and the game's frame-counted windows
                         # (stick moves, Witch Time slow-downs) to 60 Hz frames; NX_FPS_STEP=0 / NX_FPS_COUNTERS=0
                         # turn those off for comparison. Hit-stops still count frames (shorter above 60)
fifo=0                   # 1: v-sync (wait for the display refresh: no tearing, a little more latency)
aniso=                   # anisotropic filtering 2, 4, 8 or 16; empty = the game's own
model_lod=               # highest: models keep their finest detail at any distance (costs GPU time); empty = the game's

# ---- Controller ------------------------------------------------------------------------------
pad_swap=0               # 0: Nintendo layout; 1: swap A/B and X/Y for Xbox labels
pad_deadzone=            # stick dead zone, 0..20000; empty = 7849 (the usual SDL/console value)
pad_trigger=             # trigger press point, 0..32767; empty = 12000
pad_index=               # which connected controller to use, 0..7; empty = 0 (the first one)
pad_invert_x=0           # 1: invert the right stick's horizontal axis
pad_invert_y=0           # 1: invert the right stick's vertical axis

# ---- Keyboard and mouse (Windows) ------------------------------------------------------------
# Click into the window to steer the camera with the mouse; F10 or switching windows lets it go. The keyboard
# and mouse work together with a controller. Defaults: WASD move, the arrows move and press the d-pad,
# Space A, Shift B, J or right mouse X, K or left mouse Y, Q/E L/R, Z/C ZL/ZR, Enter +, Escape -, V and the
# middle mouse button the stick clicks, Numpad 8/4/5/6 the camera. Rebind any input with
# key_<input>=<key>[,<key>...] (none unbinds): inputs a b x y l r zl zr plus minus lstick rstick up down
# left right move_up move_down move_left move_right cam_up cam_down cam_left cam_right; keys A..Z, 0..9,
# F1..F9, Space, Enter, Escape, Tab, Backspace, Shift, LShift, RShift, Ctrl, LCtrl, RCtrl, Alt, Up, Down,
# Left, Right, Insert, Delete, Home, End, PageUp, PageDown, Numpad0..Numpad9, Mouse1..Mouse5.
# F1 (the settings panel), F10 and F11 are the window's own. key_zr=C,Mouse4 for example.
mouse_camera=1           # 0: the mouse does not move the camera
mouse_sens=              # mouse camera speed; empty = 1.0
mouse_invert_y=0         # 1: moving the mouse up turns the camera down

# ---- System ----------------------------------------------------------------------------------
language=en-US           # en-US, en-GB, ja, fr, fr-CA, de, it, es, es-419, ko, ru, zh-Hans, zh-Hant
handheld=0               # 1: the game renders 1280x720 (handheld) instead of 1600x900 (docked): lighter; Steam Deck
# log=/path/to/b3.log   # default: <repo>/private/b3.log

gpu_clock=               # Optional Steam Deck GPU clock in MHz; empty leaves the default clock unchanged.

discord_app_id=          # Windows: Discord Rich Presence through your own Discord application's numeric id
                         # (discord.com/developers: New Application; its name is what Discord shows). Empty: off

# ---- Audio -----------------------------------------------------------------------------------
mute=0                   # 1: no audio output

# ---- Advanced --------------------------------------------------------------------------------
# These are for other ports and for debugging. Bayonetta 3 renders at its own console size (above),
# so it ignores the display-resolution answer that render_res and render_scale change: they do
# nothing here (docs/archive/PERF-2026-10-23.md measured it). handheld above picks 900p or 720p.
render_res=              # console render size: 1920x1080 docked, 1280x720 handheld; empty = default
render_scale=            # multiplier on the console size, 0.25..2.0; empty = 1.0
ultrawide=0              # 1: experimentally widen the render to the window's aspect
mem_limit_gb=            # guest memory ceiling in GiB; empty = the runtime's default
pipelined=               # submits in flight, 2..4; empty = 3 on Linux desktop (0 = synchronous, much slower)
pipeline_cache=1         # 1: reuse the pipeline cache between runs (faster startup)
astc_bc7=                # 0: ASTC textures as RGBA8 on GPUs without ASTC (Intel Arc, AMD, Steam Deck); empty = as
                         # BC7 from a disk cache in <data root>/texcache, filled in the background the first time
texcache_mb=             # that cache's cap in MB; empty = 8192 (the oldest files go first)
headless=0               # 1: run without a window (benchmarks and the test scripts)
